# Dependabot이 공개 Caddy와 함께 갱신하도록 FROM에 digest를 직접 고정한다.
FROM caddy:2.11.8-alpine@sha256:f6228111e5fafa1a5238258d0858e103f10599b8d1659a146e7726681a002bb9

RUN setcap -r /usr/bin/caddy \
    && test -z "$(getcap /usr/bin/caddy)" \
    && addgroup -S -g 10001 brief-service \
    && adduser -S -D -H -u 10001 -G brief-service brief-service

USER 10001:10001
