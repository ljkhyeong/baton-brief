# BRIEF 프로세스에 주입할 값이다. Compose 전용 변수는 포함하지 않는다.
# DB 주소·사용자와 비밀 3개를 실제 값으로 바꾼다. 비밀은 커밋하지 않는다.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/baton_brief
SPRING_DATASOURCE_USERNAME=brief
SPRING_DATASOURCE_PASSWORD=

# 현재 토큰 2개는 서로 다른 32~200자의 URL-safe ASCII여야 한다.
BRIEF_EVENT_RECEIVER_AUTHENTICATION_REQUIRED=true
BRIEF_EVENT_RECEIVER_BEARER_TOKEN=
BRIEF_SERVICE_API_AUTHENTICATION_REQUIRED=true
BRIEF_SERVICE_API_BEARER_TOKEN=
# 토큰 교체 중에만 직전 값을 설정한다.
BRIEF_EVENT_RECEIVER_PREVIOUS_BEARER_TOKEN=
BRIEF_SERVICE_API_PREVIOUS_BEARER_TOKEN=

SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
TZ=UTC

# 앱 생존 확인은 DB와 분리하고, 요청 수신 준비 상태에는 필수 DB를 포함한다.
# 8080의 /actuator/health/liveness·readiness는 클러스터 내부에서만 확인한다.
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db
