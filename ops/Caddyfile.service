{
	admin off
	# 8443 HTTPS만 연다. 평문 80 리디렉션은 Bearer를 평문으로 받을 수 있다.
	auto_https disable_redirects
}

(brief_proxy) {
	request_body {
		max_size 64KB
	}
	header Cache-Control "no-store"
	request_header -Forwarded
	request_header -X-Forwarded-*
	request_header -Proxy-Authorization
	reverse_proxy brief:8080
}

https://{$BRIEF_SERVICE_HOST:brief-service}:8443 {
	tls /run/secrets/brief-service-tls-cert /run/secrets/brief-service-tls-key

	log {
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>uri query {
				delete sourceReference
				delete afterSourceReference
			}
		}
	}

	header -Server

	@serviceReads {
		method GET
		path_regexp service_reads ^/api/v1/(?:workspaces/[^/]+/seasons/[^/]+/(?:attention-items(?:/current|/summary|/resolutions|/transitions)?|editions(?:/latest|/weekly/latest|/[^/]+/(?:changes|freshness))?)|editions/[^/]+(?:/changes)?)$
	}
	handle @serviceReads {
		import brief_proxy
	}

	@editionGeneration {
		method POST
		path_regexp edition_generation ^/api/v1/workspaces/[^/]+/seasons/[^/]+/editions$
	}
	handle @editionGeneration {
		import brief_proxy
	}

	handle {
		respond "" 404
	}

	handle_errors {
		respond "" {err.status_code}
	}
}
