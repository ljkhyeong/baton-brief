{
	admin off
}

{$BRIEF_STAGING_HOST:brief.invalid} {
	log {
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
		}
	}

	header -Server

	# path 일치는 대소문자를 무시하므로 허용 경로는 정규식으로 정확히 맞춘다.
	@eventIngestion {
		method POST
		path_regexp event_ingestion ^/api/v1/events$
	}
	handle @eventIngestion {
		request_body {
			max_size 64KB
		}
		header Cache-Control "no-store"
		request_header -Forwarded
		request_header -X-Forwarded-*
		request_header -Proxy-Authorization
		reverse_proxy brief:8080 {
			header_up X-Forwarded-Host {$BRIEF_STAGING_HOST:brief.invalid}
			header_up X-Forwarded-Port 443
		}
	}

	handle {
		respond "" 404
	}

	handle_errors {
		respond "" {err.status_code}
	}
}
