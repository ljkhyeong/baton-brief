# 실제 비밀은 저장소 밖의 소유자 전용 파일에 두고 절대 경로만 설정한다.
BRIEF_STAGING_DATABASE_PASSWORD_FILE=/srv/baton-brief/secrets/database-password
BRIEF_STAGING_EVENT_RECEIVER_BEARER_TOKEN_FILE=/srv/baton-brief/secrets/event-receiver-bearer-token
# 평상시에는 빈 파일을 사용하고 token 교체 중에만 직전 값을 넣는다.
BRIEF_STAGING_EVENT_RECEIVER_PREVIOUS_BEARER_TOKEN_FILE=/srv/baton-brief/secrets/event-receiver-previous-bearer-token

BRIEF_STAGING_DB_NAME=baton_brief
BRIEF_STAGING_DB_USERNAME=brief
BRIEF_STAGING_IMAGE=baton-brief:staging

# 외부 reverse proxy만 접근하도록 loopback 바인딩을 유지한다.
BRIEF_STAGING_HTTP_BIND=127.0.0.1
BRIEF_STAGING_HTTP_PORT=8080
