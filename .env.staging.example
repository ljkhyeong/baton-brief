# 실제 비밀은 저장소 밖의 소유자 전용 파일에 두고 절대 경로만 설정한다.
BRIEF_STAGING_DATABASE_PASSWORD_FILE=/srv/baton-brief/secrets/database-password
BRIEF_STAGING_EVENT_RECEIVER_BEARER_TOKEN_FILE=/srv/baton-brief/secrets/event-receiver-bearer-token
# 평상시에는 빈 파일을 사용하고 token 교체 중에만 직전 값을 넣는다.
BRIEF_STAGING_EVENT_RECEIVER_PREVIOUS_BEARER_TOKEN_FILE=/srv/baton-brief/secrets/event-receiver-previous-bearer-token
# `compose.service-api.yml`을 함께 사용할 때만 필요하다.
BRIEF_STAGING_SERVICE_API_BEARER_TOKEN_FILE=/srv/baton-brief/secrets/service-api-bearer-token
# 평상시에는 빈 파일을 사용하고 token 교체 중에만 직전 값을 넣는다.
BRIEF_STAGING_SERVICE_API_PREVIOUS_BEARER_TOKEN_FILE=/srv/baton-brief/secrets/service-api-previous-bearer-token
BATON_BRIEF_PRIVATE_NETWORK=baton-brief-private

BRIEF_STAGING_DB_NAME=baton_brief
BRIEF_STAGING_DB_USERNAME=brief
BRIEF_STAGING_IMAGE=baton-brief:staging

# 외부 reverse proxy만 접근하도록 호스트 주소는 Compose에서 loopback으로 고정한다.
BRIEF_STAGING_HTTP_PORT=8080

# `--profile https`를 사용할 때만 필요하다. 실제 DNS가 이 호스트를 가리킨 뒤 활성화한다.
BRIEF_STAGING_HOST=brief.example.com
BRIEF_STAGING_HTTP_PUBLISH=80:80
BRIEF_STAGING_HTTPS_TCP_PUBLISH=443:443
BRIEF_STAGING_HTTPS_UDP_PUBLISH=443:443/udp
